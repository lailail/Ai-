{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Backend: NovelScriptApplication",
            "request": "launch",
            "mainClass": "com.qiniuyun.novelscript.NovelScriptApplication",
            "projectName": "novel-script-backend",
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "vmArgs": "-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8",
            "env": {
                "DEEPSEEK_API_KEY": "${env:DEEPSEEK_API_KEY}"
            }
        },
        {
            "type": "java",
            "name": "Backend: NovelScriptApplication (test profile)",
            "request": "launch",
            "mainClass": "com.qiniuyun.novelscript.NovelScriptApplication",
            "projectName": "novel-script-backend",
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "vmArgs": "-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8",
            "env": {
                "SPRING_PROFILES_ACTIVE": "test",
                "DEEPSEEK_API_KEY": "${env:DEEPSEEK_API_KEY}"
            }
        }
    ]
}
